{
    "name": "vscode-nim-tortoise",
    "displayName": "Nim Tortoise",
    "description": "Fork and rewrite of nimlangserver.",
    "version": "0.3.1",
    "publisher": "YOUR_PUBLISHER_ID",
    "author": {
        "name": "David Pocknee"
    },
    "license": "MIT",
    "icon": "images/nim_icon.png",
    "homepage": "https://github.com/music-theories/nimtortoise",
    "categories": [
        "Programming Languages",
        "Formatters"
    ],
    "galleryBanner": {
        "color": "#2C2A35",
        "theme": "dark"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/music-theories/nimtortoise"
    },
    "bugs": {
        "url": "https://github.com/music-theories/nimtortoise/issues"
    },
    "scripts": {
        "vscode:prepublish": "nimble release"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/mocha": "^5.2.7",
        "@types/node": "^10.17.17",
        "@types/vscode": "^1.27.0",
        "@vscode/vsce": "^2.21.1",
        "js-yaml": "^4.1.0",
        "npm-check-updates": "^16.10.15",
        "ovsx": "^0.8.3",
        "typescript": "^2.6.1",
        "vscode-test": "^1.4.0"
    },
    "engines": {
        "vscode": "^1.99.0"
    },
    "activationEvents": [
        "onLanguage:nim",
        "onLanguage:nimcfg",
        "onLanguage:nimble",
        "onCommand:nimTortoise.build",
        "onCommand:nimTortoise.run",
        "onCommand:nimTortoise.runTest",
        "onCommand:nimTortoise.execSelectionInTerminal"
    ],
    "main": "./out/vscode_nimtortoise.js",
    "contributes": {
        "languages": [
            {
                "id": "nim",
                "aliases": [
                    "Nim",
                    "nim"
                ],
                "extensions": [
                    ".nim",
                    ".nims",
                    "nim.cfg",
                    ".nim.cfg",
                    ".nimble"
                ],
                "configuration": "./nimcfg.json"
            },
            {
                "id": "nimble",
                "aliases": [
                    "Nimble",
                    "nimble"
                ],
                "extensions": [
                    ".nimble"
                ],
                "configuration": "./nimcfg.json"
            }
        ],
        "grammars": [
            {
                "language": "nim",
                "scopeName": "source.nim",
                "path": "./syntaxes/nim.json"
            },
            {
                "language": "nimble",
                "scopeName": "source.nim",
                "path": "./syntaxes/nim.json"
            }
        ],
        "problemMatchers": [
            {
                "name": "nim",
                "owner": "nim",
                "fileLocation": "absolute",
                "severity": "error",
                "pattern": {
                    "regexp": "(?!^(\\.+|Hint|\\s+$))(>+ )?(.*)\\((\\d+),\\s(\\d+)\\)\\s+((Error|Warning|Hint):\\s(.*)|(template/generic instantiation from here.*))(\\s\\[.*\\])?",
                    "file": 3,
                    "line": 4,
                    "column": 5,
                    "severity": 7,
                    "message": 8
                }
            },
            {
                "name": "nim test",
                "owner": "nim",
                "fileLocation": "absolute",
                "pattern": [
                    {
                        "regexp": "  \\[(OK|FAILED|SKIPPED)\\] (.*)",
                        "severity": 1,
                        "code": 2
                    },
                    {
                        "regexp": "    (.*)\\((\\d+), (\\d+)\\): (.*)",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "message": 4,
                        "loop": true
                    }
                ]
            }
        ],
        "viewsContainers": {
            "activitybar": [
              {
                "id": "nim",
                "title": "Nim",
                "icon": "images/nim_icon.png"
              }
            ]
          },
          "views": {
            "nim": [
              {
                "id": "nim",
                "name": "Nim"
              }
            ]
          },
        "commands": [
            {
                "command": "nimTortoise.setPerformance",
                "title": "Set Performance Level",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.run.file",
                "title": "Run selected Nim file",
                "category": "Nim Tortoise",
                "icon": "$(run)"
            },
            {
                "command": "nimTortoise.debug.file",
                "title": "Debug selected Nim file",
                "category": "Nim Tortoise",
                "icon": "$(debug-alt)"

            },
            {
                "command": "nimTortoise.check",
                "title": "Check Nim project",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.execSelectionInTerminal",
                "title": "Run Selection/Line in Nim Terminal",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.clearCaches",
                "title": "Clear internal caches",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.listCandidateProjects",
                "title": "List candidate nim projects",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.serverRestart",
                "title": "Restart Language Server",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.nimsuggestRestart",
                "title": "Restart Nimsuggest",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.nimsuggestStop",
                "title": "Stop Nimsuggest Slot",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.nimsuggestCheckProject",
                "title": "Check Project",
                "category": "Nim Tortoise",
                "icon": "$(refresh)"
            },
            {
                "command": "nimTortoise.nimbleListTasks",
                "title": "List Nimble Tasks",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.nimbleRunTask",
                "title": "Run Nimble Task",
                "category": "Nim Tortoise"
            },
            {
                "command": "nimTortoise.openGeneratedFile",
                "title": "Open Generated File",
                "category": "Nim Tortoise",
                "icon": "$(go-to-file)"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "editorLangId == 'nim'",
                    "command": "nimTortoise.run.file",
                    "group": "run@1"
                },
                {
                    "when": "editorLangId == 'nim'",
                    "command": "nimTortoise.debug.file",
                    "group": "run@2"
                },
                {
                    "when": "editorLangId == 'nim'",
                    "command": "nimTortoise.openGeneratedFile",
                    "group": "run@3"
                },
                {
                    "when": "editorLangId == 'nim' && nimTortoise:NimsuggestRestart",
                    "command": "nimTortoise.nimsuggestRestart",
                    "group": "nim@1"
                },
                {
                    "when": "editorLangId == 'nim' && nimTortoise:NimsuggestCheckProject",
                    "command": "nimTortoise.nimsuggestCheckProject",
                    "group": "nim@2"
                }
            ],
            "editor/title/run": [
                {
                    "command": "nimTortoise.run.file",
                    "when": "editorLangId == 'nim'",
                    "group": "run@1"
                },
                {
                    "command": "nimTortoise.debug.file",
                    "when": "editorLangId == 'nim'",
                    "group": "run@2"
                },
                {
                    "command": "nimTortoise.openGeneratedFile",
                    "when": "editorLangId == 'nim' && nimTortoise:generatedFileExists",
                    "group": "run@3"
                }
            ]
        },
        "keybindings": [
            {
                "key": "F6",
                "command": "nimTortoise.run.file",
                "when": "editorLangId == 'nim'"
            },
            {
                "key": "shift+F5",
                "command": "nimTortoise.debug.file",
                "when": "editorLangId == 'nim'"
            },
            {
                "key": "ctrl+alt+b",
                "command": "nimTortoise.check",
                "when": "editorLangId == 'nim'"
            },
            {
                "key": "shift+enter",
                "command": "nimTortoise.execSelectionInTerminal",
                "when": "editorFocus && editorLangId == nim && !findInputFocussed && !replaceInputFocussed"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Nim Tortoise configuration",
            "properties": {
                "nimTortoise.formatOnSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Format the file on save using nph (if installed).",
                    "scope": "resource"
                },
                "nimTortoise.performance": {
                    "type": "string",
                    "default": "LOW",
                    "enum": ["HIGHEST", "HIGH", "LOW", "LOWEST"],
                    "enumDescriptions": [
                        "Update open dependencies on change. Low request throttling. Highest CPU usage.",
                        "Update open dependencies on change. Medium request throttling. High CPU usage.",
                        "Only update dependencies on save. Medium request throttling. Low CPU usage.",
                        "Only update dependencies on save. High request throttling. Lowest CPU usage."
                    ],
                    "description": "Controls how aggressively the language server checks dependent files and throttles requests."
                },
                "nimTortoise.notificationVerbosity": {
                    "type": "string",
                    "default": "info",
                    "enum": [
                        "none",
                        "error",
                        "warning",
                        "info"
                    ],
                    "description": "Verbosity of language server notifications shown in VS Code."
                },
                "nimTortoise.logNimsuggest": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable verbose logging of nimsuggest."
                },
                "nimTortoise.maxNimsuggestProcesses": {
                    "type": "integer",
                    "default": 2,
                    "description": "Maximum number of nimsuggest processes to keep alive. 0 means unlimited."
                },
                "nimTortoise.nimsuggestPath": {
                    "type": "string",
                    "default": "nimsuggest",
                    "description": "Path to the nimsuggest binary. If set to 'nimsuggest' the binary is looked up in PATH.",
                    "scope": "resource"
                },
                "nimTortoise.nimsuggestIdleTimeout": {
                    "type": "integer",
                    "default": 1800,
                    "description": "Timeout in seconds after which an idle nimsuggest process is stopped."
                },
                "nimTortoise.nimsuggestRequestTimeout": {
                    "type": "integer",
                    "default": 30,
                    "description": "Timeout in seconds to wait for nimsuggest to respond to a request."
                },
                "nimTortoise.nimsuggestSpawnTimeout": {
                    "type": "integer",
                    "default": 60,
                    "description": "Timeout in seconds for nimsuggest to start up. Increase this for large projects (e.g. the Nim compiler) where the initial compilation takes longer than 60 seconds."
                },
                "nimTortoise.inlayHints.typeHints.enable": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable inlay type hints."
                },
                "nimTortoise.inlayHints.parameterHints.enable": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable inlay parameter hints."
                },
                "nimTortoise.lsp.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the Nim language server."
                },
                "nimTortoise.lsp.path": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Nim language server executable. If empty, the extension looks for it in PATH.",
                    "scope": "resource"
                },
                "nimTortoise.transportMode": {
                    "type": "string",
                    "default": "stdio",
                    "enum": [
                        "stdio",
                        "socket"
                    ],
                    "description": "Transport mode used to connect to the language server."
                },
                "nimTortoise.lspPort": {
                    "type": "integer",
                    "default": 0,
                    "description": "Socket port for the language server when transportMode is 'socket'. 0 means the extension starts the server and assigns a port automatically."
                },
                "nimTortoise.notificationTimeout": {
                    "type": "integer",
                    "default": 15,
                    "description": "Timeout in seconds before language server notifications are automatically dismissed. Use 0 to disable."
                },
                "nimTortoise.nimbleAutoSetup": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically run 'nimble setup' when a .nimble file is detected, to generate nimble.paths."
                },
                "nimTortoise.buildCommand": {
                    "type": "string",
                    "default": "c",
                    "description": "Nim compiler backend used when building (c, cpp, js, etc.).",
                    "scope": "resource"
                }
            }
        },
        "breakpoints": [
            {
                "language": "nim"
            }
        ],
        "mcpServerDefinitionProviders": [
            {
                "id": "nimTortoise",
                "label": "Nim Language Server"
            }
        ],
        "chatSkills": [
            {
                "path": "./skills/nim-mcp-tools/SKILL.md"
            }
        ],
        "snippets": [
            {
                "language": "nim",
                "path": "./snippets/nim.json"
            }
        ]
    }
}
